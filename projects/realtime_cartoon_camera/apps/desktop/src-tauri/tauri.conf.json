{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "实时漫画相机",
  "version": "0.1.0",
  "identifier": "cn.coursenotes.realtimecartooncamera",
  "build": {
    "beforeDevCommand": {"script": "npm.cmd run dev", "cwd": "../.."},
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {"script": "npm.cmd run build", "cwd": "../.."},
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "实时漫画相机", "width": 1280, "height": 900, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
