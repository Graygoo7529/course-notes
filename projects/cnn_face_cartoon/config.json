{
  "seed": 42,
  "device": "auto",
  "preprocess": {
    "canvas_size": 384,
    "exif_transpose": true,
    "resize_mode": "letterbox",
    "denoise": "light_bilateral",
    "brightness_correction": "underexposed_only"
  },
  "features": {
    "target_strides": [4, 8, 16],
    "weights": [0.5, 0.3, 0.2],
    "normalization_quantiles": [0.1, 0.95],
    "epsilon": 0.000001,
    "edge_floor": 0.25
  },
  "face": {
    "backend": "mediapipe_face_landmarker",
    "model_path": "model/face_landmarker.task",
    "on_detection_failure": "record_and_disable_geometry",
    "eye_mouth_threshold_multiplier": 0.8,
    "cheek_threshold_multiplier": 1.3
  },
  "style": {
    "palette": "natural_warm",
    "palette_rgb": [
      [34, 31, 35], [73, 51, 45], [119, 80, 62], [169, 117, 87],
      [211, 164, 126], [236, 202, 166], [248, 228, 202], [246, 244, 233],
      [69, 102, 119], [117, 145, 151], [91, 113, 83], [165, 81, 73]
    ],
    "line_density": 0.5,
    "ink_rgb": [42, 34, 35],
    "line_width": 0.8,
    "contour_width": 1.2,
    "max_spline_deviation_px": 1.5,
    "supersample": 3,
    "shadow_enabled": false
  },
  "output": {
    "directory": "outputs",
    "remove_padding": true,
    "save_raw_features": false
  }
}
